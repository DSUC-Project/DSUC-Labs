# Production/Deployment Configuration
# Reference file for deploying to production (Render, Vercel, etc.)

NODE_ENV=production
PORT=3001

# Frontend URL for CORS
FRONTEND_URL=https://dsuc.fun

# Extra SPA origin if needed (optional)
# ADMIN_FRONTEND_URL=

# ====================================
# Auth secrets (REQUIRED in production)
# ====================================
# Use a long random string. Never ship the default development secret.
JWT_SECRET=replace-with-long-random-secret

# ====================================
# Supabase Configuration (REQUIRED)
# ====================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=

# ====================================
# Google OAuth
# ====================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-api-host/api/auth/google/callback

# ====================================
# Optional: ImageBB API for file uploads
# ====================================
# IMAGEBB_API_KEY=your-imagebb-api-key
