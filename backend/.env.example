# Backend environment variables
# Prefer .env.example.local for mock local, .env.example.deployment for production

PORT=3001
NODE_ENV=development
USE_MOCK_DB=true

# CORS + wallet sign-in message domain
FRONTEND_URL=http://localhost:5173

# JWT signing secret — change for any shared or production environment
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Supabase (required when USE_MOCK_DB=false)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Google OAuth
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Optional
# IMAGEBB_API_KEY=
# ADMIN_FRONTEND_URL=
