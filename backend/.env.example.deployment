# Production/Deployment Configuration
# Reference file for deploying to production (Render, Vercel, etc.)

# Database Mode - Use Supabase in production
USE_MOCK_DB=false

# Server Configuration
NODE_ENV=production
PORT=3001

# Frontend URL for CORS + wallet sign-in message domain
FRONTEND_URL=https://dsuc.fun

# Extra SPA origin if needed (optional)
# ADMIN_FRONTEND_URL=

# ====================================
# Auth secrets (REQUIRED in production)
# ====================================
# Use a long random string. Never ship the default development secret.
JWT_SECRET=replace-with-long-random-secret

# ====================================
# Supabase Configuration (REQUIRED when USE_MOCK_DB=false)
# ====================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ====================================
# Google OAuth (recommended for community + Google login)
# ====================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-api-host/api/auth/google/callback

# ====================================
# Optional: ImageBB API for file uploads
# Get your API key from: https://api.imgbb.com/
# ====================================
# IMAGEBB_API_KEY=your-imagebb-api-key
