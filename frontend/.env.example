# Frontend environment variables for Vite
# Copy to .env (or use .env.example.local / .env.example.deployment)

# Required for API calls
VITE_API_BASE_URL=http://localhost:3001
VITE_FRONTEND_URL=http://localhost:5173

# Google Identity Services (SPA login button)
# Same Client ID as backend GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional: force local-auth UI affordances
# VITE_ENABLE_LOCAL_AUTH=true

# Optional: direct Supabase from browser (not required for main product flow)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=public-anon-key-goes-here
