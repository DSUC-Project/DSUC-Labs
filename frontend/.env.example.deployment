# Production/Deployment Configuration
# Reference file for deploying to production (Vercel, Netlify, etc.)

# Backend API URL (production)
VITE_API_BASE_URL=https://dsuc-labs-xmxl.onrender.com

# Frontend URL (production)
VITE_FRONTEND_URL=https://dsuc.fun

# Google Identity Services client id (must match backend Google OAuth client)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Do not enable local auth flags in production deployments.
# VITE_ENABLE_LOCAL_AUTH=false

# ====================================
# Supabase from the browser is optional and not required for the main API flow.
# Prefer all data access through the Express backend.
# ====================================
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
